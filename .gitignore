# exclude all files, but not the parent dir
*
!*/
!*.py
!*.md
# except these
!.gitignore

# Generic stage rules anywhere in the tree.
# 02_SYN: ignore all generated files, but keep synthesis log.
**/02_SYN/*
!**/02_SYN/syn.log

# 03_GATE and 09_SUBMIT: fully ignored.
**/03_GATE/
**/09_SUBMIT/

# 00_TESTBED and 02_RTL: track only source/text artifacts.
**/00_TESTBED/*
!**/00_TESTBED/**/*.v
!**/00_TESTBED/**/*.py
!**/00_TESTBED/**/*.cpp
!**/00_TESTBED/**/*.txt

**/01_RTL/*
!**/01_RTL/**/*.v
!**/01_RTL/**/*.py
!**/01_RTL/**/*.cpp
!**/01_RTL/**/*.txt

**/02_RTL/*
!**/02_RTL/**/*.v
!**/02_RTL/**/*.py
!**/02_RTL/**/*.cpp
!**/02_RTL/**/*.txt

# Ignore common memory dumps/artifacts.
**/Memory/
**/Memory*/


